# Copiá este archivo a .env y completá los valores de tu proyecto de Supabase
# (Project Settings > API). Estas dos son públicas por diseño: Expo las
# incluye en el bundle del cliente y quedan protegidas por las RLS
# policies de supabase/migrations, no por estar "ocultas".
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Las siguientes NO se leen desde la app (nunca deben tener el prefijo
# EXPO_PUBLIC_). Son secrets de las Edge Functions y se cargan con:
#   supabase secrets set GOOGLE_CLOUD_VISION_KEY=...
# Se listan acá solo como referencia de qué hay que configurar más adelante
# (sprint 5/6 para OCR y foto de vencimiento, sprint 7/8 para voz).
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_VISION_KEY=
GEMINI_API_KEY=
GOOGLE_SPEECH_TO_TEXT_KEY=
