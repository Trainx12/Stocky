{
  "expo": {
    "name": "Stocky",
    "slug": "Stocky",
    "scheme": "stocky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stocky2026.stocky"
    },
    "web": {
      "name": "STOCKY",
      "shortName": "STOCKY",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stocky necesita acceder a tus fotos para leer tickets y fechas de vencimiento.",
          "cameraPermission": "Stocky necesita la cámara para fotografiar tickets y fechas de vencimiento."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Stocky necesita el micrófono para cargar productos y fechas de vencimiento por voz.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B2FF7"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "c32c54c1-1191-48d3-8f96-e5b98ebc3082"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c32c54c1-1191-48d3-8f96-e5b98ebc3082"
    }
  }
}
